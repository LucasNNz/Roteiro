{
  "manifest_version": 3,
  "name": "Corvo Bridge",
  "version": "0.3.0",
  "description": "Envia trabalhos do CorvoQuiz ao GPT em segundo plano, confirma o envio e aguarda a Action.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://roteiro-mu.vercel.app/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Corvo Bridge"},
  "options_page": "options.html",
  "content_scripts": [
    {"matches": ["https://roteiro-mu.vercel.app/*"], "js": ["app-bridge.js"], "run_at": "document_start"},
    {"matches": ["https://chatgpt.com/*"], "js": ["chatgpt-bridge.js"], "run_at": "document_idle"}
  ],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
