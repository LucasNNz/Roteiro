{
  "manifest_version": 3,
  "name": "Corvo Bridge",
  "version": "0.6.14",
  "description": "Encaminha especialistas do CorvoQuiz, captura arquivos e exclui conversas mapeadas com sincronização por estado da interface, confirmação estável e verificação forte de remoção real.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.blob.vercel-storage.com/*",
    "https://*.public.blob.vercel-storage.com/*",
    "https://*.oaiusercontent.com/*",
    "https://chatgpt.com/*",
    "https://roteiro-mu.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Corvo Bridge"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://roteiro-mu.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
