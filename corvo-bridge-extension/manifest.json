{
  "manifest_version": 3,
  "name": "Corvo Bridge",
  "version": "0.6.26",
  "description": "Encaminha especialistas do CorvoQuiz em segundo plano, com checkpoints, retries sem roubar foco, diagnóstico, captura de arquivos, Central ao Vivo, batching, retomada persistente de anexos e Cleaner resiliente.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.oaiusercontent.com/*",
    "https://chatgpt.com/*",
    "https://roteiro-mu.vercel.app/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Corvo Bridge"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://roteiro-mu.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
