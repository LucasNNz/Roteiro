{
  "manifest_version": 3,
  "name": "Corvo Collector Bridge",
  "version": "0.7.4",
  "description": "Corvo Collector com procurar mais na triagem manual, por grupo.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs",
    "offscreen",
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Corvo Collector Bridge"
  },
  "externally_connectable": {
    "matches": [
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}